# ─────────────────────────────────────────────────────────────
# THE JOURNAL — environment variables
# Copy to .env and fill in. Never commit .env (it is gitignored).
# ─────────────────────────────────────────────────────────────

# Supabase Postgres — Project Settings → Database → Connection string.
# DATABASE_URL uses the transaction pooler (port 6543) for the app.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL is the non-pooled connection (port 5432) used by
# `prisma db push` / `prisma migrate`.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Secret used to sign admin session (JWT) cookies.
# Generate: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Admin login
ADMIN_USERNAME="dhan"

# bcrypt hash of the admin password — NOT the plain password.
# Generate: npm run hash -- "your-real-password"
# IMPORTANT: escape every "$" in the hash as "\$" — Next.js treats an
# unescaped $ in .env as a variable reference. e.g. \$2a\$12\$abcd...
# (On Vercel, paste the raw hash with real "$" — no escaping needed there.)
ADMIN_PASSWORD_HASH="\$2a\$12\$replace-with-a-real-bcrypt-hash"

# Public site URL (used for SEO canonical URLs, sitemap, RSS, OG tags).
# No trailing slash. In production set this to your real domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Image uploads (optional) ─────────────────────────────────
# Lets the editor upload photos instead of only pasting URLs.
#  1. Supabase → Storage → New bucket "post-images", make it PUBLIC.
#  2. Supabase → Settings → API Keys → "Secret keys" → reveal the
#     sb_secret_… key and paste it below (legacy service_role also works).
# SUPABASE_URL is auto-derived from DATABASE_URL if left unset.
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_URL="https://xxxx.supabase.co"

# ── Telegram bot for After Hours (optional) ──────────────────
# Lets you add media entries by messaging a private Telegram bot.
#  1. Message @BotFather → /newbot → copy the token below.
#  2. Message @userinfobot to get your own numeric Telegram id.
#  3. Pick any long random string for the webhook secret.
#  4. After deploying with these set, visit /api/telegram/setup while
#     logged into /admin — it registers the webhook for you.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_OWNER_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""
