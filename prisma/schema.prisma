// THE JOURNAL — data model.
// PostgreSQL (Supabase) for both development and production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Post {
  id          String     @id @default(cuid())
  title       String     @default("Untitled Draft")
  slug        String     @unique
  content     String     @default("")
  excerpt     String     @default("")
  tags        String[]   @default([])
  status      PostStatus @default(DRAFT)
  readingTime Int        @default(1)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?
  deletedAt   DateTime?

  versions PostVersion[]

  @@index([status, publishedAt])
  @@index([deletedAt])
  @@index([updatedAt])
}

// ── After Hours — a private media & mood tracker ──────────────

enum MediaType {
  BOOK
  MOVIE
  SERIES
  MANGA
  MUSIC
}

enum MediaStatus {
  PLANNED
  ONGOING
  COMPLETED
  DROPPED
}

model MediaEntry {
  id         String      @id @default(cuid())
  type       MediaType
  title      String
  creator    String      @default("") // author / director / artist / studio
  cover      String      @default("") // image URL
  rating     Float        @default(0) // 0 – 5, half steps
  genres     String[]     @default([])
  moods      String[]     @default([])
  status     MediaStatus  @default(PLANNED)
  notes      String       @default("")
  favorite   Boolean      @default(false)
  consumedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([favorite])
  @@index([updatedAt])
}

// A lightweight snapshot taken on autosave / publish, powering version history.
model PostVersion {
  id      String @id @default(cuid())
  postId  String
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  title   String
  content String
  excerpt String
  tags    String[] @default([])
  label   String   @default("autosave")

  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}
