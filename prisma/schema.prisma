// THE JOURNAL — data model.
// PostgreSQL (Supabase) for both development and production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Post {
  id          String     @id @default(cuid())
  title       String     @default("Untitled Draft")
  slug        String     @unique
  content     String     @default("")
  excerpt     String     @default("")
  tags        String[]   @default([])
  status      PostStatus @default(DRAFT)
  readingTime Int        @default(1)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?
  deletedAt   DateTime?

  versions PostVersion[]

  @@index([status, publishedAt])
  @@index([deletedAt])
  @@index([updatedAt])
}

// ── After Hours — a private media & mood tracker ──────────────

enum MediaType {
  BOOK
  MOVIE
  SERIES
  MANGA
  MUSIC
}

enum MediaStatus {
  PLANNED
  ONGOING
  COMPLETED
  DROPPED
}

model MediaEntry {
  id         String      @id @default(cuid())
  type       MediaType
  title      String
  creator    String      @default("") // author / director / artist / studio
  cover      String      @default("") // image URL
  rating     Float        @default(0) // 0 – 5, half steps
  genres     String[]     @default([])
  moods      String[]     @default([])
  status     MediaStatus  @default(PLANNED)
  notes      String       @default("")
  favorite   Boolean      @default(false)
  consumedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([favorite])
  @@index([updatedAt])
}

// A lightweight snapshot taken on autosave / publish, powering version history.
model PostVersion {
  id      String @id @default(cuid())
  postId  String
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  title   String
  content String
  excerpt String
  tags    String[] @default([])
  label   String   @default("autosave")

  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

// ── Finance Deck — a private Gold + money-market fund tracker ──

enum InvestmentAsset {
  GOLD
  RDPU
}

// One purchase. Gold: quantity in grams, price per gram. RDPU: quantity in
// units, price = NAB per unit. `amount` is what was actually paid (fees in).
model Investment {
  id       String          @id @default(cuid())
  asset    InvestmentAsset
  fundId   Int? // Pasardana fund id (RDPU) — drives the automatic NAB lookup
  fundName String          @default("")
  platform String          @default("") // where it was bought: Pegadaian, Bibit…
  quantity Float
  price    Float
  amount   Float
  date     DateTime        @db.Date
  notes    String          @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([asset, date])
}

// One closing price per instrument per day. `key` is "GOLD" (IDR per gram)
// or "RDPU:<fundId>" / "RDPU:name:<fund name>" (NAB per unit). Daily rows
// accumulate into the price history the analytics are drawn from.
model MarketPrice {
  id     String   @id @default(cuid())
  key    String
  date   DateTime @db.Date
  price  Float
  source String   @default("auto") // "auto" | "manual" — manual is never overwritten

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, date])
}
